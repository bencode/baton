{
  "name": "@baton/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "seed": "tsx src/seed.ts",
    "seed:user": "tsx src/seed-user.ts",
    "token": "tsx src/seed-token.ts",
    "bind": "tsx src/user-bind.ts bind",
    "unbind": "tsx src/user-bind.ts unbind",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test 'src/**/*.test.ts'",
    "db:migrate": "prisma migrate dev",
    "db:backfill-inputs": "tsx src/migrate-session-inputs.ts",
    "db:generate": "prisma generate",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@baton/shared": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@hono/node-ws": "^1.3.1",
    "@libsql/client": "^0.17.3",
    "@prisma/adapter-libsql": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.8",
    "hono": "^4.13.13",
    "nanoid": "^3.3.12",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/web-push": "3.6.4",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
