# 本地 PostgreSQL（起法见 README Quick start）。
DATABASE_URL="postgresql://baton:baton@localhost:5432/baton"
# 测试用：每个测试在这台 PG 上建/删一个临时库，账号需要 CREATEDB 权限。
BATON_TEST_DATABASE_URL="postgresql://baton:baton@localhost:5432/postgres"

# Optional: dedicated mini project provisioner credential; empty disables creation.
# Generate with: openssl rand -hex 32
BATON_PROVISIONER_TOKEN=
